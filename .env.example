# Copy to .env.local (never committed) and fill in a free key from https://api.nasa.gov/.
# NASA_API_KEY is read by tools/fetch-donki.mjs (node --env-file=.env.local ...).
# VITE_NASA_API_KEY is used by the page for live space weather; it ends up in
# the built page, so only ever use a free api.nasa.gov key here.
NASA_API_KEY=
VITE_NASA_API_KEY=
